{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:worker": "wrangler dev --port 8787",
    "cf:types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply travision-tours --local",
    "prebuild": "tsx scripts/generate-seo.ts",
    "build": "npm run build:client && npm run build:ssr && npm run prerender",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr --emptyOutDir",
    "prerender": "tsx scripts/prerender.ts",
    "build:production": "node scripts/build-production.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:csp": "node scripts/check-csp.mjs",
    "check:budget": "node scripts/check-budget.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "optimize:images:clean": "node scripts/optimize-images.mjs --clean",
    "optimize:images:prune": "node scripts/optimize-images.mjs --prune-only",
    "fonts": "node scripts/self-host-fonts.mjs",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:worker": "vitest run tests/worker",
    "test:legacy": "tsx scripts/phase3-unit.ts",
    "test:images": "tsx scripts/phase5-images.ts",
    "test:seo": "tsx scripts/phase6-seo.ts",
    "test:a11y": "node scripts/phase7-a11y.mjs",
    "test:keyboard": "node scripts/phase7-keyboard.mjs",
    "content:sheet": "tsx scripts/phase8-content-sheet.ts",
    "test:acceptance": "node scripts/phase3-acceptance.mjs",
    "test:e2e": "playwright test",
    "verify:fast": "npm run typecheck && npm run lint && npm run test && npm run build && npm run test:images && npm run test:seo && npm run check:csp && npm run check:budget",
    "verify": "npm run verify:fast && npm run test:e2e",
    "cms:seed": "tsx scripts/cms-seed.ts",
    "cms:validate": "tsx scripts/cms-validate.ts",
    "cms:export": "tsx scripts/cms-export.ts",
    "cms:diff": "tsx scripts/cms-diff.ts"
  },
  "dependencies": {
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260728.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "axe-core": "^4.13.0",
    "cheerio": "^1.2.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.13",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.4.3",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.2"
  }
}
