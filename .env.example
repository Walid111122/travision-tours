# ---------------------------------------------------------------------------
# Build-time configuration
# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. Nothing here is secret: every value below ends up
# in the published HTML. Server-side secrets belong in Cloudflare (use
# `wrangler secret put`) or, locally, in .dev.vars (gitignored).

# The canonical origin of the site. Used for canonical URLs, Open Graph tags,
# sitemap.xml and robots.txt, so it must be the real public origin.
#
#   - Must be https.
#   - Must NOT be localhost — a localhost value fails the build outright,
#     because it can never belong in a published canonical URL.
#   - If it is unset, a normal `npm run build` warns and falls back to a
#     placeholder. `npm run build:production` refuses to run at all, which is
#     what stops a launch from shipping canonical URLs for a domain the owner
#     does not control.
#
# During Part A there is no domain yet, so leave this commented out and use the
# placeholder. Uncomment it as soon as the domain exists.
# SITE_URL="https://travisiontours.com"

# Legacy alias for SITE_URL. Accepted so an existing .env keeps working; prefer
# SITE_URL. Do NOT set this to a localhost value — it will fail the build.
# VITE_APP_URL="https://travisiontours.com"

# Cloudflare Turnstile site key (public by design — it is rendered in the page).
# Leave empty in local development: the inquiry forms then skip the widget, and
# the Worker's TURNSTILE_DEV_BYPASS handles verification.
VITE_TURNSTILE_SITE_KEY=""
